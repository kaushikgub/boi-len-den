# Copy to .env for local runs. Compose has its own inline defaults; these are for
# running the Nest apps directly on the host (pnpm start:*) against the compose infra.

NODE_ENV=development
LOG_LEVEL=debug

# --- Ports (host) ---
GATEWAY_PORT=3000
AUTH_PORT=3001
RENTAL_PORT=3002
INVENTORY_PORT=3003

# --- Postgres (one per service, host ports) ---
AUTH_DATABASE_URL=postgres://auth:auth@localhost:5433/auth
RENTAL_DATABASE_URL=postgres://rental:rental@localhost:5434/rental
INVENTORY_DATABASE_URL=postgres://inventory:inventory@localhost:5435/inventory

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Kafka / Schema Registry (host listener) ---
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- JWT (RS256) — auth-service holds the private key; others use the public key ---
# Generated locally into ./keys (gitignored). See README "Generate signing keys".
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
ACCESS_TOKEN_TTL=900            # 15 minutes
REFRESH_TOKEN_TTL=1209600       # 14 days
