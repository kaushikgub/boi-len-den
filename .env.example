# Copy to .env for local runs. Compose has its own inline defaults; these are for
# running the Nest apps directly on the host (pnpm start:*) against the compose infra.

NODE_ENV=development
LOG_LEVEL=debug

# --- Ports (host) ---
GATEWAY_PORT=3000
AUTH_PORT=3001
RENTAL_PORT=3002
INVENTORY_PORT=3003
CATALOG_PORT=3004

# --- Postgres (one per service, host ports) ---
AUTH_DATABASE_URL=postgres://auth:auth@localhost:5433/auth
RENTAL_DATABASE_URL=postgres://rental:rental@localhost:5434/rental
INVENTORY_DATABASE_URL=postgres://inventory:inventory@localhost:5435/inventory
CATALOG_DATABASE_URL=postgres://catalog:catalog@localhost:5436/catalog

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Kafka / Schema Registry (host listener) ---
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Gateway: downstream targets + JWKS source + rate limit ---
AUTH_SERVICE_URL=http://localhost:3001
RENTAL_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
CATALOG_SERVICE_URL=http://localhost:3004
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60

# --- inventory-service ---
RESERVATION_TTL_SECONDS=60     # how long a HELD reservation lives before the sweeper frees it
SWEEP_INTERVAL_SECONDS=15      # how often the sweeper runs

# --- JWT (RS256) — auth-service holds the private key; others use the public key ---
# Generated locally into ./keys (gitignored). See README "Generate signing keys".
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
ACCESS_TOKEN_TTL=900            # 15 minutes
REFRESH_TOKEN_TTL=1209600       # 14 days

# --- Seed admin (auth-service). Dev defaults to admin@boi-len-den.local/admin12345.
# In production an admin is only seeded if ADMIN_EMAIL + ADMIN_PASSWORD are set.
ADMIN_EMAIL=admin@boi-len-den.local
ADMIN_PASSWORD=admin12345
