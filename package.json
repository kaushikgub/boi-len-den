{
  "name": "boi-len-den",
  "version": "0.1.0",
  "private": true,
  "description": "Book rental platform — NestJS microservices monorepo",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "build:all": "nest build api-gateway && nest build auth-service && nest build rental-service && nest build inventory-service && nest build catalog-service && nest build notification-service",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-service --watch",
    "start:rental": "nest start rental-service --watch",
    "start:inventory": "nest start inventory-service --watch",
    "start:catalog": "nest start catalog-service --watch",
    "start:notification": "nest start notification-service --watch",
    "test": "jest",
    "test:int": "jest --config ./jest.int.config.js",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:down:clean": "docker compose down -v",
    "infra:up": "docker compose up -d postgres-auth postgres-rental postgres-inventory postgres-catalog postgres-notification redis kafka schema-registry kafka-init mailpit",
    "infra:down": "docker compose down -v",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,libs}/**/*.ts\""
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "^3",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^10",
    "ajv": "^8",
    "ajv-formats": "^3",
    "bcrypt": "^5",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "cookie-parser": "^1.4",
    "express": "^4",
    "http-proxy-middleware": "^3",
    "ioredis": "^5",
    "jsonwebtoken": "^9",
    "jwks-rsa": "^3",
    "kafkajs": "^2",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^8.0.10",
    "pg": "^8",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
